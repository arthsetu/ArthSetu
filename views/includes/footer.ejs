<!-- ✅ Chat Button -->
<button onclick="toggleChat(event)" id="chatBtn">
  💬
</button>

<!-- ✅ Sidebar Chat -->
<div id="chatSidebar">
  <div id="chatHeader">
    <span>AI Assistant</span>
    <button onclick="toggleChat(event)">✖</button>
  </div>

  <iframe src="https://arthsetuchatbot.onrender.com"></iframe>
</div>

<style>
#chatBtn {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #4CAF50;
  color: white;
  border: none;
  padding: 14px 18px;
  border-radius: 50%;
  font-size: 18px;
  cursor: pointer;
  z-index: 1000;
}

/* 🔥 Sidebar container */
#chatSidebar {
  position: fixed;
  top: 0;
  right: -400px;
  width: 400px;
  height: 100vh;
  background: white;
  box-shadow: -5px 0 20px rgba(0,0,0,0.2);
  transition: right 0.3s ease;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

/* When open */
#chatSidebar.active {
  right: 0;
}

/* Header (above iframe) */
#chatHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  background: #4CAF50;
  color: white;
  font-weight: bold;
  position: relative;
  z-index: 1002;
}

#chatHeader button {
  background: none;
  border: none;
  color: white;
  font-size: 18px;
  cursor: pointer;
}

/* Chat iframe */
#chatSidebar iframe {
  flex: 1;
  width: 100%;
  border: none;
  z-index: 1000;
}
</style>

<script>
function toggleChat(e) {
  if (e) e.stopPropagation();

  const sidebar = document.getElementById("chatSidebar");
  sidebar.classList.toggle("active");
}

/* ✅ Click outside to close */
document.addEventListener("click", function(e) {
  const sidebar = document.getElementById("chatSidebar");
  const button = document.getElementById("chatBtn");

  if (
    sidebar.classList.contains("active") &&
    !sidebar.contains(e.target) &&
    e.target !== button
  ) {
    sidebar.classList.remove("active");
  }
});
</script>
