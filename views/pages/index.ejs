                    <div class="feature-icon">📊</div>
                    <h5>Visual Reports</h5>
                    <p>Beautiful charts and graphs to visualize your spending patterns clearly.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🤝</div>
                    <h5>Bill Splitter</h5>
                    <p>Split bills with friends easily. Track who owes what without awkwardness.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">🔒</div>
                    <h5>100% Secure</h5>
                    <p>Your data is encrypted and protected. We never share your information.</p>
                </div>
            </div>
        </div>
    </div>
</section>

