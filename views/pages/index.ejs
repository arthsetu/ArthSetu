                </div>
            </div>
            <div class="col-md-1 d-none d-md-flex align-items-center justify-content-center">
                <span style="font-size:2rem; color: var(--gold)">→</span>
            </div>
            <div class="col-md-3">
                <div class="step-card">
                    <div class="step-number">3</div>
