<!-- HERO -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6 hero-content">
                <h1>Take Control of Your <span>Finances</span> Today</h1>
                <p>ArthSetu helps college students track expenses, set budgets, and make smarter financial decisions — all in one place.</p>

                <div>
                    <a href="/register" class="btn-hero-primary">Get Started Free</a>
                    <a href="#features" class="btn-hero-secondary">Learn More</a>
                </div>

                <div class="hero-stats">
                    <div class="hero-stat">
                        <h3>500+</h3>
                        <p>Students Using</p>
                    </div>
                    <div class="hero-stat">
                        <h3>₹2L+</h3>
                        <p>Expenses Tracked</p>
                    </div>
                    <div class="hero-stat">
                        <h3>5★</h3>
                        <p>Rated by Users</p>
                    </div>
                </div>
            </div>

            <!-- Floating Card -->
            <div class="col-lg-5 offset-lg-1 d-none d-lg-block">
                <div class="hero-card">
                    <div class="label">This Month's Spending</div>
                    <div class="amount">₹4,280</div>

                    <div class="mt-3">
                        <div class="expense-item">
                            <div>
                                <span class="expense-dot" style="background:#FF6384"></span>
                                Food & Drinks
                            </div>
                            <strong>₹1,200</strong>
                        </div>
                        <div class="expense-item">
                            <div>
                                <span class="expense-dot" style="background:#36A2EB"></span>
                                Transport
                            </div>
                            <strong>₹580</strong>
                        </div>
                        <div class="expense-item">
                            <div>
                                <span class="expense-dot" style="background:#FFCE56"></span>
                                Shopping
                            </div>
                            <strong>₹2,500</strong>
                        </div>
                    </div>

                    <div class="mt-3 pt-2" style="border-top: 2px solid #f0f0f0">
                        <div class="d-flex justify-content-between">
                            <span style="color:#6c757d">Budget Left</span>
                            <strong style="color:#1a7a4a">₹1,720</strong>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

