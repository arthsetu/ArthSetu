<% layout('layouts/boilerplate') %>


<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2>🏦 Savings Goal Tracker</h2>
        <p class="text-muted">Set goals, track progress and celebrate milestones!</p>
    </div>

    <div class="row">

        <!-- CREATE GOAL FORM -->
        <div class="col-md-4 mb-4">
            <div style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); position: sticky; top: 20px;">
                <h5 style="font-weight: 700; color: #1a1a2e; margin-bottom: 20px;">🎯 New Savings Goal</h5>

                <form action="/goals" method="POST">

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600;">Goal Emoji</label>
                        <select name="emoji" class="form-select"
                            style="border-radius: 10px; border: 2px solid #e9ecef;">
                            <option value="✈️">✈️ Trip</option>
                            <option value="📱">📱 Gadget</option>
                            <option value="👟">👟 Shopping</option>
                            <option value="📚">📚 Education</option>
                            <option value="🏠">🏠 Rent</option>
                            <option value="🎮">🎮 Gaming</option>
                            <option value="🚗">🚗 Vehicle</option>
                            <option value="💊">💊 Health</option>
                            <option value="🎯">🎯 Other</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600;">Goal Title</label>
                        <input type="text" name="title" class="form-control"
                            placeholder="e.g. Goa Trip with friends"
                            style="border-radius: 10px; border: 2px solid #e9ecef;"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600;">Target Amount (₹)</label>
                        <input type="number" name="targetAmount" class="form-control"
                            placeholder="e.g. 5000"
                            style="border-radius: 10px; border: 2px solid #e9ecef;"
                            required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" style="font-weight: 600;">
                            Deadline 
                            <span style="color: #6c757d; font-weight: 400;">(optional)</span>
                        </label>
                        <input type="date" name="deadline" class="form-control"
                            style="border-radius: 10px; border: 2px solid #e9ecef;">
                    </div>

                    <button type="submit"
                        style="width: 100%; background: linear-gradient(135deg, #1a7a4a, #c9a84c); color: white; border: none; padding: 14px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 1rem;">
                        Create Goal 🚀
                    </button>

                </form>
            </div>
        </div>

        <!-- GOALS LIST -->
        <div class="col-md-8">

            <% if (goals.length === 0) { %>
                <div style="background: white; border-radius: 20px; padding: 60px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
                    <div style="font-size: 3rem; margin-bottom: 15px;">🏦</div>
                    <h5 style="color: #1a1a2e; font-weight: 700;">No Goals Yet!</h5>
                    <p style="color: #6c757d;">Create your first savings goal and start your journey!</p>
                </div>

            <% } else { %>

                <% goals.forEach(function(goal) { %>
                    <%
                        let percentage = Math.min((goal.savedAmount / goal.targetAmount * 100), 100).toFixed(1);
                        let remaining = goal.targetAmount - goal.savedAmount;
                        let daysLeft = null;
                        if (goal.deadline) {
                            let diff = new Date(goal.deadline) - new Date();
                            daysLeft = Math.ceil(diff / (1000 * 60 * 60 * 24));
                        }
                    %>

                    <div style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); margin-bottom: 20px; border-left: 5px solid <%= goal.completed ? '#1a7a4a' : '#c9a84c' %>;">

                        <!-- Goal Header -->
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 20px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="font-size: 2.5rem;"><%= goal.emoji %></div>
                                <div>
                                    <h5 style="font-weight: 700; color: #1a1a2e; margin: 0;">
                                        <%= goal.title %>
                                        <% if (goal.completed) { %>
                                            <span style="background: #e8f5e9; color: #1a7a4a; font-size: 0.7rem; padding: 3px 10px; border-radius: 20px; margin-left: 8px;">
                                                ✅ Completed!
                                            </span>
                                        <% } %>
                                    </h5>
                                    <% if (daysLeft !== null) { %>
                                        <small style="color: <%= daysLeft < 7 ? '#e74c3c' : '#6c757d' %>;">
                                            <%= daysLeft > 0 ? daysLeft + ' days left' : 'Deadline passed!' %>
                                        </small>
                                    <% } %>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 1.5rem; font-weight: 800; color: #1a7a4a;">
                                    ₹<%= goal.savedAmount %>
                                </div>
                                <small style="color: #6c757d;">of ₹<%= goal.targetAmount %></small>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div style="margin-bottom: 20px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <small style="color: #6c757d;"><%= percentage %>% complete</small>
                                <small style="color: #e74c3c; font-weight: 600;">
                                    ₹<%= remaining > 0 ? remaining : 0 %> remaining
                                </small>
                            </div>
                            <div style="background: #f0f0f0; border-radius: 10px; height: 14px;">
                                <div style="background: linear-gradient(90deg, #1a7a4a, #c9a84c); width: <%= percentage %>%; height: 14px; border-radius: 10px; transition: width 0.5s;">
                                </div>
                            </div>
                        </div>

                        <!-- Add Money + Delete -->
                        <% if (!goal.completed) { %>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <form action="/goals/<%= goal._id %>/add" method="POST" 
                                    style="display: flex; gap: 8px; flex: 1;">
                                    <input type="number" name="amount"
                                        placeholder="Add amount (₹)"
                                        min="1"
                                        style="flex: 1; border-radius: 10px; border: 2px solid #e9ecef; padding: 8px 12px;"
                                        required>
                                    <button type="submit"
                                        style="background: #1a7a4a; color: white; border: none; padding: 8px 20px; border-radius: 10px; font-weight: 600; cursor: pointer; white-space: nowrap;">
                                        + Add ₹
                                    </button>
                                </form>

                                <form action="/goals/<%= goal._id %>/delete" method="POST">
                                    <button type="submit"
                                        style="background: #fff0f0; color: #e74c3c; border: none; padding: 8px 14px; border-radius: 10px; font-weight: 600; cursor: pointer;">
                                        🗑️
                                    </button>
                                </form>
                            </div>
                        <% } else { %>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div style="background: #e8f5e9; padding: 10px 20px; border-radius: 10px;">
                                    <span style="color: #1a7a4a; font-weight: 700;">
                                        🎉 Goal Achieved! Congratulations!
                                    </span>
                                </div>
                                <form action="/goals/<%= goal._id %>/delete" method="POST">
                                    <button type="submit"
                                        style="background: #fff0f0; color: #e74c3c; border: none; padding: 8px 14px; border-radius: 10px; font-weight: 600; cursor: pointer;">
                                        🗑️
                                    </button>
                                </form>
                            </div>
                        <% } %>

                    </div>
                <% }) %>

            <% } %>
        </div>
    </div>
</div>

