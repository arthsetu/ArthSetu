        purpose: ["seeds", "general"],
        landRequired: 0.5,
        description: "Crop insurance scheme. Farmers pay only 2% premium for Kharif crops.",
        eligibility: "All farmers growing notified crops",
        documents: "Land records, Aadhaar, Bank account",
        icon: "🛡️"
    },
    {
        name: "Agriculture Infrastructure Fund",
        bank: "Scheduled Banks / NBFC",
        maxAmount: 2000000,
        interestRate: 3,
        duration: "5-10 years",
        purpose: ["storage", "equipment", "irrigation"],
        landRequired: 2,
        description: "3% interest subvention for post-harvest management and agriculture infrastructure.",
        eligibility: "Farmers, FPOs, Agri-entrepreneurs",
        documents: "Project report, Land records, Business plan",
        icon: "🏭"
    },
    {
        name: "SBI Kisan Gold Card",
        bank: "State Bank of India",
        maxAmount: 500000,
        interestRate: 7,
        duration: "3-5 years",
        purpose: ["seeds", "equipment", "general"],
        landRequired: 1,
        description: "Revolving credit facility for farmers with good credit history.",
        eligibility: "Existing KCC holders with good track record",
        documents: "KCC history, Land records, Aadhaar",
        icon: "💳"
    },
    {
        name: "Dairy Entrepreneurship Development Scheme",
        bank: "NABARD",
        maxAmount: 700000,
        interestRate: 6.5,
        duration: "5-7 years",
        purpose: ["dairy"],
        landRequired: 0,
        description: "For setting up small dairy farms. 25% back-ended capital subsidy available.",
        eligibility: "Farmers, individual entrepreneurs",
        documents: "Project report, Land/shed documents, Aadhaar",
        icon: "🐄"
    },
    {
        name: "National Livestock Mission",
        bank: "Commercial Banks / RRBs",
        maxAmount: 1000000,
        interestRate: 5,
        duration: "5-7 years",
        purpose: ["poultry", "dairy"],
        landRequired: 0,
        description: "For poultry, sheep, goat and pig rearing. Subsidy up to 50% for SC/ST farmers.",
        eligibility: "All farmers and entrepreneurs",
