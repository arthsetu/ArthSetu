<% layout('layouts/boilerplate') %>
<%- include('../includes/navbar') %>

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2>🌾 Agriculture Loan Calculator</h2>
        <p class="text-muted">Find government schemes and calculate your EMI instantly</p>
    </div>

    <div class="row">

        <!-- LEFT — Input Form -->
        <div class="col-md-4 mb-4">
            <div style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); position: sticky; top: 20px;">
                <h5 style="font-weight: 700; color: #1a1a2e; margin-bottom: 20px;">📋 Your Details</h5>

                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600;">Monthly Income (₹)</label>
                    <input type="number" id="income" class="form-control"
                        placeholder="e.g. 15000"
                        style="border-radius: 10px; border: 2px solid #e9ecef;">
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600;">Land Size (Acres)</label>
                    <input type="number" id="landSize" class="form-control"
                        placeholder="e.g. 2.5"
                        style="border-radius: 10px; border: 2px solid #e9ecef;">
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600;">Land Type</label>
                    <select id="landType" class="form-select"
                        style="border-radius: 10px; border: 2px solid #e9ecef;">
                        <option value="irrigated">Irrigated Land</option>
                        <option value="non-irrigated">Non-Irrigated Land</option>
                        <option value="horticulture">Horticulture</option>
                        <option value="dairy">Dairy Farming</option>
                        <option value="poultry">Poultry Farming</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600;">Loan Purpose</label>
                    <select id="purpose" class="form-select"
                        style="border-radius: 10px; border: 2px solid #e9ecef;">
                        <option value="seeds">Seeds & Fertilizers</option>
                        <option value="equipment">Farm Equipment</option>
                        <option value="irrigation">Irrigation Setup</option>
                        <option value="land">Land Purchase</option>
                        <option value="storage">Storage & Warehouse</option>
                        <option value="general">General Agriculture</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label" style="font-weight: 600;">State</label>
                    <select id="state" class="form-select"
                        style="border-radius: 10px; border: 2px solid #e9ecef;">
                        <option value="mp">Madhya Pradesh</option>
                        <option value="up">Uttar Pradesh</option>
                        <option value="raj">Rajasthan</option>
                        <option value="mah">Maharashtra</option>
                        <option value="pun">Punjab</option>
                        <option value="har">Haryana</option>
                        <option value="guj">Gujarat</option>
                        <option value="kar">Karnataka</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <button onclick="findSchemes()"
                    style="width: 100%; background: linear-gradient(135deg, #1a7a4a, #c9a84c); color: white; border: none; padding: 14px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 1rem;">
                    🔍 Find Schemes & Calculate
                </button>
            </div>
        </div>

        <!-- RIGHT — Results -->
        <div class="col-md-8">

            <!-- Default state -->
            <div id="defaultState" style="background: white; border-radius: 20px; padding: 60px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
                <div style="font-size: 3rem; margin-bottom: 15px;">🌾</div>
                <h5 style="color: #1a1a2e; font-weight: 700;">Enter Your Details</h5>
                <p style="color: #6c757d;">Fill in your information on the left to see eligible government schemes and calculate EMI!</p>
            </div>

            <!-- Results -->
            <div id="results" style="display: none;">

                <!-- Eligibility Summary -->
                <div id="eligibilitySummary" style="background: linear-gradient(135deg, #1a1a2e, #1a7a4a); border-radius: 20px; padding: 25px; color: white; margin-bottom: 20px;">
                    <h5 style="color: #c9a84c; margin-bottom: 15px;">💰 Your Loan Eligibility</h5>
                    <div class="row">
                        <div class="col-4 text-center">
                            <div style="font-size: 1.5rem; font-weight: 800; color: #c9a84c;" id="maxLoan">₹0</div>
                            <small style="color: rgba(255,255,255,0.7);">Max Loan Amount</small>
                        </div>
                        <div class="col-4 text-center">
                            <div style="font-size: 1.5rem; font-weight: 800; color: #c9a84c;" id="minRate">0%</div>
                            <small style="color: rgba(255,255,255,0.7);">Lowest Interest</small>
                        </div>
                        <div class="col-4 text-center">
                            <div style="font-size: 1.5rem; font-weight: 800; color: #c9a84c;" id="schemeCount">0</div>
                            <small style="color: rgba(255,255,255,0.7);">Schemes Available</small>
                        </div>
                    </div>
                </div>

                <!-- Eligible Schemes -->
                <div style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); margin-bottom: 20px;">
                    <h5 style="font-weight: 700; color: #1a1a2e; margin-bottom: 20px;">🏛️ Eligible Government Schemes</h5>
                    <div id="schemesList"></div>
                </div>

                <!-- EMI Calculator -->
                <div style="background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
                    <h5 style="font-weight: 700; color: #1a1a2e; margin-bottom: 20px;">🧮 EMI Calculator</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label" style="font-weight: 600;">Loan Amount (₹)</label>
                            <input type="number" id="emiLoanAmount" class="form-control"
                                placeholder="e.g. 100000"
                                style="border-radius: 10px; border: 2px solid #e9ecef;"
                                oninput="calculateEMI()">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" style="font-weight: 600;">Interest Rate (%)</label>
                            <input type="number" id="emiRate" class="form-control"
                                placeholder="e.g. 7"
                                style="border-radius: 10px; border: 2px solid #e9ecef;"
                                oninput="calculateEMI()">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" style="font-weight: 600;">Duration (Years)</label>
                            <select id="emiYears" class="form-select"
                                style="border-radius: 10px; border: 2px solid #e9ecef;"
                                onchange="calculateEMI()">
                                <option value="1">1 Year</option>
                                <option value="2">2 Years</option>
                                <option value="3" selected>3 Years</option>
                                <option value="5">5 Years</option>
                                <option value="7">7 Years</option>
                                <option value="10">10 Years</option>
                                <option value="15">15 Years</option>
                            </select>
                        </div>
                    </div>

                    <!-- EMI Results -->
                    <div id="emiResults" style="display: none;">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div style="background: #e8f5e9; border-radius: 16px; padding: 20px; text-align: center;">
                                    <div style="font-size: 1.8rem; font-weight: 800; color: #1a7a4a;" id="monthlyEMI">₹0</div>
                                    <small style="color: #6c757d;">Monthly EMI</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="background: #fff8e1; border-radius: 16px; padding: 20px; text-align: center;">
                                    <div style="font-size: 1.8rem; font-weight: 800; color: #c9a84c;" id="totalPayment">₹0</div>
                                    <small style="color: #6c757d;">Total Payment</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="background: #fce4ec; border-radius: 16px; padding: 20px; text-align: center;">
                                    <div style="font-size: 1.8rem; font-weight: 800; color: #e74c3c;" id="totalInterest">₹0</div>
                                    <small style="color: #6c757d;">Total Interest</small>
                                </div>
                            </div>
                        </div>

                        <!-- Payment breakdown bar -->
                        <div style="margin-top: 20px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                                <small style="color: #1a7a4a; font-weight: 600;">Principal</small>
                                <small style="color: #e74c3c; font-weight: 600;">Interest</small>
                            </div>
                            <div style="background: #f0f0f0; border-radius: 10px; height: 14px; overflow: hidden;">
                                <div id="principalBar" style="background: #1a7a4a; height: 14px; border-radius: 10px; transition: width 0.5s;"></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
// ===== HARDCODED SCHEMES DATABASE =====
const schemes = [
