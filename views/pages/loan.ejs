        description: "For purchase of agricultural land by landless farmers and SC/ST beneficiaries.",
        eligibility: "Landless farmers, SC/ST category",
        documents: "Income proof, Aadhaar, Sale deed",
        icon: "🗺️"
    }
];

// ===== FIND SCHEMES FUNCTION =====
function findSchemes() {
    const income = parseFloat(document.getElementById('income').value) || 0;
    const landSize = parseFloat(document.getElementById('landSize').value) || 0;
    const landType = document.getElementById('landType').value;
    const purpose = document.getElementById('purpose').value;

    if (income === 0 || landSize === 0) {
        alert('Please enter your monthly income and land size!');
        return;
    }

    // Calculate max loan eligibility (60x monthly income or land based)
    const incomeBasedLoan = income * 60;
    const landBasedLoan = landSize * 100000;
    const maxEligible = Math.min(Math.max(incomeBasedLoan, landBasedLoan), 5000000);

    // Filter eligible schemes
    const eligible = schemes.filter(scheme => {
        const purposeMatch = scheme.purpose.includes(purpose) || scheme.purpose.includes('general');
        const landMatch = landSize >= scheme.landRequired;
        const amountMatch = scheme.maxAmount <= maxEligible * 2;
        return purposeMatch && landMatch && amountMatch;
    });

    // Find lowest interest rate
    const lowestRate = Math.min(...eligible.map(s => s.interestRate));

    // Update summary
    document.getElementById('maxLoan').textContent = '₹' + maxEligible.toLocaleString('en-IN');
    document.getElementById('minRate').textContent = lowestRate + '%';
    document.getElementById('schemeCount').textContent = eligible.length;

    // Render schemes
    const schemesList = document.getElementById('schemesList');
    schemesList.innerHTML = '';

    if (eligible.length === 0) {
        schemesList.innerHTML = '<p class="text-muted">No schemes found. Try different criteria.</p>';
    } else {
        eligible.forEach(function(scheme) {
            schemesList.innerHTML += `
                <div style="border: 2px solid #e9ecef; border-radius: 16px; padding: 20px; margin-bottom: 15px; cursor: pointer; transition: all 0.3s;"
                    onmouseover="this.style.borderColor='#1a7a4a'"
                    onmouseout="this.style.borderColor='#e9ecef'"
                    onclick="selectScheme(${scheme.maxAmount}, ${scheme.interestRate})">

                    <div style="display: flex; justify-content: space-between; align-items: start;">
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <span style="font-size: 2rem;">${scheme.icon}</span>
                            <div>
                                <h6 style="font-weight: 700; color: #1a1a2e; margin: 0;">${scheme.name}</h6>
                                <small style="color: #6c757d;">${scheme.bank}</small>
                            </div>
                        </div>
                        <div style="text-align: right; flex-shrink: 0;">
                            <div style="background: #e8f5e9; color: #1a7a4a; padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.85rem;">
                                ${scheme.interestRate}% p.a.
                            </div>
                            <small style="color: #6c757d;">Up to ₹${scheme.maxAmount.toLocaleString('en-IN')}</small>
                        </div>
                    </div>

                    <p style="color: #6c757d; font-size: 0.9rem; margin: 12px 0 8px;">${scheme.description}</p>

                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <small style="color: #1a7a4a;"><strong>Duration:</strong> ${scheme.duration}</small>
                        <small style="color: #1a7a4a;"><strong>Docs:</strong> ${scheme.documents}</small>
                    </div>

                    <div style="margin-top: 10px; padding: 8px 12px; background: #f8f9fa; border-radius: 8px;">
                        <small style="color: #6c757d;"><strong>Eligibility:</strong> ${scheme.eligibility}</small>
                    </div>

                    <div style="margin-top: 10px;">
                        <small style="color: #c9a84c; font-weight: 600;">👆 Click to calculate EMI for this scheme</small>
                    </div>
                </div>
            `;
        });
    }

    // Show results
    document.getElementById('defaultState').style.display = 'none';
    document.getElementById('results').style.display = 'block';

    // Pre-fill EMI calculator
    document.getElementById('emiLoanAmount').value = Math.min(maxEligible, eligible[0]?.maxAmount || 100000);
    document.getElementById('emiRate').value = lowestRate;
    calculateEMI();

    // Scroll to results
    document.getElementById('results').scrollIntoView({ behavior: 'smooth' });
}

// ===== SELECT SCHEME FOR EMI =====
function selectScheme(amount, rate) {
    document.getElementById('emiLoanAmount').value = amount;
    document.getElementById('emiRate').value = rate;
    calculateEMI();
    document.getElementById('emiResults').scrollIntoView({ behavior: 'smooth' });
}

// ===== EMI CALCULATOR =====
function calculateEMI() {
    const P = parseFloat(document.getElementById('emiLoanAmount').value) || 0;
    const annualRate = parseFloat(document.getElementById('emiRate').value) || 0;
    const years = parseFloat(document.getElementById('emiYears').value) || 1;

    if (P === 0 || annualRate === 0) {
        document.getElementById('emiResults').style.display = 'none';
        return;
    }

    const R = annualRate / 12 / 100;
    const N = years * 12;

    // EMI Formula
    const EMI = P * R * Math.pow(1 + R, N) / (Math.pow(1 + R, N) - 1);
    const totalPayment = EMI * N;
    const totalInterest = totalPayment - P;
    const principalPercent = (P / totalPayment * 100).toFixed(1);

    // Update UI
    document.getElementById('monthlyEMI').textContent = '₹' + Math.round(EMI).toLocaleString('en-IN');
    document.getElementById('totalPayment').textContent = '₹' + Math.round(totalPayment).toLocaleString('en-IN');
    document.getElementById('totalInterest').textContent = '₹' + Math.round(totalInterest).toLocaleString('en-IN');
    document.getElementById('principalBar').style.width = principalPercent + '%';

    document.getElementById('emiResults').style.display = 'block';
}
</script>

