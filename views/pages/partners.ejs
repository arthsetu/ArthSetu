            </div>

            <div class="col-md-4">
                <h4>Secure</h4>
                <p>Safe financial integrations</p>
            </div>

            <div class="col-md-4">
                <h4>Better Offers</h4>
                <p>Exclusive deals for our users</p>
            </div>

        </div>

    </div>
</section>

<!-- CTA -->
<section style="background: linear-gradient(135deg, #1a1a2e 0%, #1a7a4a 100%); padding:80px 0; text-align:center;">
    <div class="container">
        <h2 style="color:white; font-weight:800; margin-bottom: 20px;">Want to Partner With Us?</h2>
        <a href="/contact" style="background:#c9a84c; color: #1a1a2e; padding:15px 40px; border-radius:30px; text-decoration:none; font-weight:700;">
            Contact Us →
        </a>
    </div>
</section>
